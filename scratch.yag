fn main() {
  // disable sound
  *AUDIO_MAIN = 0;
  
  // wait for vblank and disable lcd
  loop {
    if *LY == VBLANK_START {
      break
    }
  }
  *LCDC = 0;

  // set tile data manually
  let tile = &VRAM_BLOCK_8000[0][0];
  let pattern = $AA;
  for _ in 0..BYTES_PER_TILE {
    *tile = pattern;
    *tile += 1;
  }
  pattern = $FF;
  for _ in 0..BYTES_PER_TILE {
    *tile = pattern;
    *tile += 1;
  }
  
  // set tilemap data
  let tile_id = &TILEMAP_9800[0];
  for _ in 0..EIGHT_ROWS_OF_TILES {
    *tile_id = 0;
    tile_id += 1;
  }
  for _ in 0..EIGHT_ROWS_OF_TILES {
    *tile_id = 1;
    tile_id += 1;
  }
  
  // set palette
  *BGP = 0b11_10_01_00;
  
  // enable lcd with background and block_8000
  *LCDC = 0b1000_1001;
  
  // loop forever
  loop {}
}
