
static mmio($8800) VRAM_BLOCK_8000: [u8; 128];
static mmio($9800) TILEMAP_9800: [u8; 32*32];
static mmio($FF40) LCDC: u8;
static mmio($FF44) LY: u8;
static mmio($FF47) BGP: u8;

const VBLANK_START: u8 = 144;
const TILES_PER_ROW: u8 = 32;

fn main() {
  // wait for vblank and disable lcd
  loop {
    if *LY == VBLANK_START {
      break
    }
  }
  *LCDC = 0;
  // set tile data
  VRAM_BLOCK_8000[0] = $AA;
  VRAM_BLOCK_8000[1] = $FF;
  // set tilemap data
  let tile_id = &TILEMAP_9800[0];
  for _ in 0..(8*TILES_PER_ROW) {
    *tile_id = 0;
    tile_id += 1;
  }
  for _ in 0..(8*TILES_PER_ROW) {
    *tile_id = 1;
    tile_id += 1;
  }
  // set palette
  *BGP = 0b11_10_01_00;
  // enable lcd with background
  *LCDC = 0b1000_1001;
  // loop forever
  loop {}
}
