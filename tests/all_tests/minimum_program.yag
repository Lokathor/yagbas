fn main() {
  // wait for vblank and disable lcd
  loop {
    if *$FF44 == 144 {
      break
    }
  }
  *$FF40 = 0;
  // set tile data
  *$8800 = $AA;
  *$8801 = $FF;
  // set tilemap data
  let tile_id = $9800;
  for _ in 0..(32*8) {
    *tile_id = 0;
    tile_id += 1;
  }
  for _ in 0..(32*8) {
    *tile_id = 1;
    tile_id += 1;
  }
  // set palette
  *$FF47 = 0b11_10_01_00;
  // enable lcd
  *$FF40 = 0b1000_0001;
  // loop forever
  loop {}
}
