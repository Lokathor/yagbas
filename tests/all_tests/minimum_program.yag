bitbag LcdCtrl {
  background: 0,
  lcd: 7,
}

static mmio($FF40) LCDC: LcdCtrl;
static mmio($FF44) LY: u8;
static mmio($FF47) BGP: u8;

const DEFAULT_PALETTE: u8 = 0b11_10_01_00;

fn main() {
  // safely disable LCD
  loop {
    if *LY == 144 {
      break
    }
  }
  *LCDC = LcdCtrl {};

  // Draw a basic pattern with a basic palette.
  let p = VRAM_BASE;
  loop VRAM_BYTE_COUNT {
    *p = $AA;
    p += 1;
  }
  *BGP = DEFAULT_PALETTE;

  // Re-activate the LCD.
  *LCDC = LcdCtrl {lcd, background};
}
